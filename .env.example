# Copy to .env.local and fill in.

# Where data comes from:
#   mock  in-memory SkyHaven API with sample listings and a test payment gateway (default; no backend needed)
#   api   the real SkyHaven API at API_URL
SKYHAVEN_DATA_SOURCE=mock

# The SkyHaven API, read on the server only. NEXT_PUBLIC_API_URL is used if API_URL is not set.
API_URL=http://localhost:4000/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Public address of this site, for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mock only: delay every API call by this many milliseconds, to see loading states.
MOCK_LATENCY_MS=0

# Mock only: hours after the move-in date before held rent is released automatically (same name as the API).
ESCROW_AUTO_RELEASE_HOURS=72
