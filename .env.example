# Copy to .env.local and fill in.

# Sign-up, sign-in and every signed-in feature always use the real API at API_URL.
# Find a Home listings: sample (16 sample homes, default) or api (the real API).
SKYHAVEN_LISTINGS_SOURCE=sample

# The SkyHaven API, read on the server only. NEXT_PUBLIC_API_URL is used if API_URL is not set.
API_URL=http://localhost:4000/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Public address of this site, for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sample listings only: delay each read by this many milliseconds, to see loading states.
MOCK_LATENCY_MS=0

